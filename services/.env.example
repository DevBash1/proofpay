# Copy to .env, or let `npm run setup:testnet` generate it. Never commit .env.
NEAR_RPC_URL=https://test.rpc.fastnear.com
ESCROW_CONTRACT=escrow.example.testnet
TOKEN_CONTRACT=tusd.example.testnet

CLIENT_ACCOUNT=
CLIENT_KEY=
FREELANCER_ACCOUNT=
FREELANCER_KEY=
EDITOR_ACCOUNT=
VERIFIER_ACCOUNT=
VERIFIER_KEY=
ARBITER_ACCOUNT=
OWNER_ACCOUNT=
OWNER_KEY=

# Demo job terms
REVIEW_WINDOW_SECS=120
DELIVERABLES_URL=http://localhost:5190

# How often the verifier polls the contract, in ms
VERIFIER_POLL_MS=3000

# Optional: let a NEAR AI Cloud model judge free-text criteria
NEAR_AI_API_KEY=
